# Copie para .env e preencha. Sem VITE_SUPABASE_URL o app roda em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# WhatsApp do suporte da plataforma (aparece para os lojistas)
VITE_SUPPORT_WHATSAPP=
# Chave Pix da plataforma, para os lojistas pagarem a mensalidade
VITE_PLATFORM_PIX_KEY=
# Aplicação do Mercado Pago (pagamento online com split). Ver docs/mercado-pago.md
VITE_MP_CLIENT_ID=
